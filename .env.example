# Copiá este archivo a .env y completá los valores. Nunca commitees el .env.

# --- Ubicación de búsqueda (obligatoria) ---
# Por defecto: centro de Rosario, Santa Fe
SEARCH_ADDRESS="Córdoba 1000, Rosario, Santa Fe, Argentina"
SEARCH_LAT=-32.9468
SEARCH_LNG=-60.6393
SEARCH_CITY=rosario

# --- Conectores (true/false) ---
CONNECTOR_PEDIDOSYA_ENABLED=true
CONNECTOR_RAPPI_ENABLED=true
CONNECTOR_MERCADOLIBRE_ENABLED=false
CONNECTOR_UBEREATS_ENABLED=false

# --- Scraping ---
SCRAPE_MIN_DELAY_SECONDS=2
SCRAPE_MAX_DELAY_SECONDS=6
SCRAPE_MAX_RETRIES=3
SCRAPE_CACHE_TTL_MINUTES=20
# false = abre una ventana de Chrome visible (menos probabilidad de bloqueo)
SCRAPE_HEADLESS=false
# Cuántas fichas de heladerías abrir para leer precios por producto
PEDIDOSYA_MAX_STORE_DETAILS=5

# --- Base de datos ---
DATABASE_URL=sqlite:///data/helados.sqlite

# --- Scheduler ---
SCHEDULER_INTERVAL_MINUTES=45

# --- Notificaciones ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
