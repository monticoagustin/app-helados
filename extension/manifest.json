{
  "manifest_version": 3,
  "name": "Helados · Buscador de descuentos",
  "version": "0.9.0",
  "description": "Trae los descuentos de heladerías de PedidosYa y Rappi a teskel.online/helados. Uso personal.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.rappi.com.ar/*",
    "https://www.pedidosya.com.ar/*",
    "https://www.ubereats.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://teskel.online/cuartito*",
        "https://teskel.space.fast/cuartito*",
        "https://teskel.online/helados*",
        "https://teskel.space.fast/helados*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Abrir buscador de helados"
  }
}
